# ─── Supabase (Required) ──────────────────────────────────────────────────────

# Your Supabase project API URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in client-side code)
# Found in: Supabase Dashboard → Project Settings → API → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ─── Server-only API Functions (Required for /api/health and cron) ────────────

# Supabase project URL for serverless functions. Do not expose service keys in VITE_* vars.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key. Server-side only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bearer token required by /api/health and /api/keep-alive. Use a long random value.
CRON_SECRET=replace-with-a-long-random-secret

# ─── Supabase CLI (Optional  only needed for local dev with Supabase CLI) ────

# Your Supabase project reference ID (the subdomain of your project URL)
# e.g. if URL is https://abcdefgh.supabase.co → project ID is abcdefgh
VITE_SUPABASE_PROJECT_ID=your-project-ref
